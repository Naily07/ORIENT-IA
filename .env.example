GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Code d'accès du backoffice (frontend-next/, et frontend/ Streamlit).
# Laisser vide = espace admin ouvert, annoncé comme tel dans l'interface —
# ce n'est de toute façon pas un contrôle de sécurité robuste (le prototype
# ne manipule aucune donnée personnelle).
ORIENTIA_ADMIN_CODE=

# Clé de signature des sessions admin de frontend-next/ (JWT HS256, cookie
# httpOnly). Nécessaire uniquement si ORIENTIA_ADMIN_CODE est défini.
# Générer avec : openssl rand -base64 32
SESSION_SECRET=
