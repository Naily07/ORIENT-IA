# Utilisé seulement pour lancer `npm run dev` de façon autonome, sans passer
# par run.ps1/run.sh (qui exportent ces mêmes variables depuis le .env
# racine). Copier vers .env.local.

# URL de l'API FastAPI (backend/).
API_URL=http://localhost:8000

# Code d'accès du backoffice — laisser vide = espace admin ouvert, annoncé
# comme tel dans l'interface. Doit correspondre à ORIENTIA_ADMIN_CODE du
# .env racine si les deux frontends (Next.js et Streamlit) doivent partager
# le même accès.
ORIENTIA_ADMIN_CODE=

# Clé de signature des sessions admin (JWT HS256, cookie httpOnly).
# Nécessaire uniquement si ORIENTIA_ADMIN_CODE est défini.
# Générer avec : openssl rand -base64 32
SESSION_SECRET=
